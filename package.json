{
  "name": "@he0119/dsh-tailnet-admin",
  "version": "0.1.0",
  "description": "把 Tailnet / 反向代理页面当作「本机」来用：启用 host 持久化设置，并按需关闭浏览器会话校验（Host/Origin 栅栏保持不动）。",
  "icon": "./icon.svg",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsdown --concurrency 1",
    "build:host": "tsdown --filter \"@he0119/dsh-tailnet-admin/host\"",
    "build:client": "tsdown --filter \"@he0119/dsh-tailnet-admin/client\"",
    "build:types": "tsdown --filter \"@he0119/dsh-tailnet-admin/types\"",
    "watch": "tsdown --watch --concurrency 1",
    "prepare": "node --run prebuild && node --run build",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tailscale",
    "tailnet",
    "reverse-proxy",
    "remote-admin",
    "loopback"
  ],
  "license": "MIT",
  "author": "uy/sun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/he0119/dsh-tailnet-admin.git"
  },
  "homepage": "https://github.com/he0119/dsh-tailnet-admin",
  "bugs": {
    "url": "https://github.com/he0119/dsh-tailnet-admin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0"
  }
}
